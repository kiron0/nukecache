{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "declaration": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "outDir": "dist"
  },
  "include": [
    "src",
    "tests",
    "tsup.config.ts",
    "vitest.config.ts",
    "eslint.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
